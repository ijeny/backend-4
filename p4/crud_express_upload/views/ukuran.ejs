<!DOCTYPE html>
<html lang="en">

<head>
    <title>Manajemen Ukuran</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        body {
            background: #f5f5f5;
        }

        .container-box {
            width: 72%;
            margin: 40px auto;
            border: 2px solid #6b8e23;
            padding: 20px;
            background: #fff;
        }
    </style>
</head>

<body>
    <div class="container-box">
        <h2 class="text-center mb-4">Manajemen Ukuran</h2>

        <% if (alert && alert.message) { %>
            <div class="alert alert-<%= alert.type === 'danger' ? 'danger' : 'success' %>" role="alert">
                <%= alert.message %>
            </div>
            <% } %>

                <form action="/ukuran" method="POST" class="mb-3">
                    <div class="row g-2">
                        <div class="col-md-9">
                            <input type="text" name="nama_ukuran" class="form-control" placeholder="Contoh: L" required>
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-success w-100">Tambah Ukuran</button>
                        </div>
                    </div>
                </form>

                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th width="90">ID</th>
                            <th>Nama Ukuran</th>
                            <th width="180">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!sizes.length) { %>
                            <tr>
                                <td colspan="3" class="text-center">Belum ada data ukuran</td>
                            </tr>
                            <% } %>

                                <% sizes.forEach(size=> { %>
                                    <tr>
                                        <td>
                                            <%= size.id %>
                                        </td>
                                        <td>
                                            <%= size.nama_ukuran %>
                                        </td>
                                        <td>
                                            <a href="/ukuran/edit/<%= size.id %>"
                                                class="btn btn-warning btn-sm">Edit</a>
                                            <a href="/ukuran/delete/<%= size.id %>" class="btn btn-danger btn-sm"
                                                onclick="return confirm('Yakin ingin menghapus ukuran ini?')">Hapus</a>
                                        </td>
                                    </tr>
                                    <% }) %>
                    </tbody>
                </table>

                <a href="/" class="btn btn-secondary">Kembali ke Produk</a>
    </div>
</body>

</html>