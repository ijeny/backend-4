<!DOCTYPE html>
<html>

<head>
    <title>
        <%= title %>
    </title>
</head>

<body>

    <h1>CRUD DATA MAHASISWA</h1>

    <table border="1" cellpadding="10">
        <tr>
            <th>No</th>
            <th>Nama</th>
            <th>NIM</th>
            <th>Jurusan</th>
            <th>Alamat</th>
        </tr>

        <% mahasiswa.forEach((item, index)=> { %>
            <tr>
                <td>
                    <%= index + 1 %>
                </td>
                <td>
                    <%= item.nama %>
                </td>
                <td>
                    <%= item.nim %>
                </td>
                <td>
                    <%= item.jurusan %>
                </td>
                <td>
                    <%= item.alamat %>
                </td>
            </tr>
            <% }) %>

    </table>

</body>

</html>